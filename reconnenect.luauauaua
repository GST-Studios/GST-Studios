loadstring(game:HttpGet("https://raw.githubusercontent.com/evxncodes/mainroblox/refs/heads/main/anti-afk"))()
loadstring(game:HttpGet("https://raw.githubusercontent.com/MICKYcyber/Animation-Dump/refs/heads/main/PermaDeath.luau"))()

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local reconnecting = false

local scripts = [[
loadstring(game:HttpGet("https://raw.githubusercontent.com/GST-Studios/GST-Studios/refs/heads/main/reconnenect.luauauaua"))()
loadstring(game:HttpGet("https://raw.githubusercontent.com/MICKYcyber/Animation-Dump/refs/heads/main/PermaDeath.luau"))()
loadstring(game:HttpGet("https://raw.githubusercontent.com/evxncodes/mainroblox/refs/heads/main/anti-afk"))()
]]

local function queueScripts()
	if queue_on_teleport then
		queue_on_teleport(scripts)
	elseif syn and syn.queue_on_teleport then
		syn.queue_on_teleport(scripts)
	end
end

local function reconnect()
	if reconnecting then
		return
	end

	reconnecting = true
	queueScripts()

	TeleportService:Teleport(game.PlaceId, player)
end

GuiService.ErrorMessageChanged:Connect(function()
	if reconnecting then
		return
	end

	local errorcode = GuiService:GetErrorCode()
	local message = GuiService.ErrorMessage

	if errorcode == 277
		or message:find("Please check your internet connection and try again.", 1, true) then
		reconnect()
	end
end)
