local GUI = game:GetService("GuiService")
local TPS = game:GetService("TeleportService")
local P = game:GetService("Players")

local Client = P["LocalPlayer"]

GUI["ErrorMessageChanged"]:Connect(function()
    queue_on_teleport([[loadstring(game:HttpGet("https://raw.githubusercontent.com/GST-Studios/GST-Studios/refs/heads/main/reconnenect.luauauaua"))()]])
    TPS:TeleportToPlaceInstance(game["PlaceId"], game["JobId"], Client)
end)
